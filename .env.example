# Langer Zufallswert, z. B. mit: openssl rand -base64 48
# Sichert die Anmeldung ab. Wird er geändert, müssen sich alle neu anmelden.
SECRET_KEY=

# Erster Benutzer, wird nur beim allerersten Start angelegt (Passwort mindestens 12 Zeichen).
ADMIN_USER=admin
ADMIN_PASSWORD=

# true, wenn die Seite über HTTPS erreichbar ist (hinter dem Reverse Proxy). Nur für lokale Tests false.
COOKIE_SECURE=true

TZ=Europe/Berlin
# Beim allerersten Start vier Beispielobjekte anlegen.
BEISPIELE=true
# Protokollzeilen, die je Objekt aufbewahrt werden.
LOG_KEEP=2000

# Sicherung: Abstand der automatischen Sicherung in Stunden (0 = aus) und Zahl der aufbewahrten Dateien
BACKUP_HOURS=24
BACKUP_KEEP=14
